{
  "name": "jww-viewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "inspect": "node tools/inspect.ts",
    "check": "tsc --noEmit",
    "verify": "node tools/verify-measure.ts samples/*.jww",
    "e2e": "node tools/e2e.mjs",
    "cert": "node tools/make-cert.mjs",
    "dev:https": "node tools/dev-https.mjs",
    "e2e:pinch": "node tools/e2e-pinch.mjs",
    "e2e:pwa": "node tools/e2e-pwa.mjs",
    "verify:snap": "node tools/verify-snap.ts samples/*.jww",
    "fuzz": "node tools/fuzz.ts samples/*.jww",
    "e2e:robust": "node tools/e2e-robust.mjs",
    "e2e:measure": "node tools/e2e-measure.mjs",
    "probe:magnifier": "node tools/probe-magnifier.mjs",
    "e2e:display": "node tools/e2e-display.mjs"
  },
  "devDependencies": {
    "playwright": "^1.62.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
