{
  "name": "jww-viewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "inspect": "node tools/inspect.ts",
    "check": "tsc --noEmit",
    "verify": "node tools/verify-measure.ts",
    "e2e": "node tools/e2e.mjs",
    "cert": "node tools/make-cert.mjs",
    "dev:https": "node tools/dev-https.mjs",
    "e2e:pinch": "node tools/e2e-pinch.mjs",
    "e2e:pwa": "npm run build && node tools/e2e-pwa.mjs",
    "verify:snap": "node tools/verify-snap.ts",
    "fuzz": "node tools/fuzz.ts",
    "e2e:robust": "node tools/e2e-robust.mjs",
    "e2e:measure": "node tools/e2e-measure.mjs",
    "probe:magnifier": "node tools/probe-magnifier.mjs",
    "e2e:display": "node tools/e2e-display.mjs",
    "e2e:layers": "node tools/e2e-layers.mjs",
    "verify:inspect": "node tools/verify-inspect.ts",
    "verify:area": "node tools/verify-area.ts",
    "verify:serve": "node tools/verify-serve.mjs",
    "e2e:modes": "node tools/e2e-modes.mjs",
    "e2e:fit": "node tools/e2e-fit.mjs",
    "e2e:files": "node tools/e2e-files.mjs",
    "e2e:ui": "node tools/e2e-ui.mjs",
    "ios:sync": "npm run build && cap sync ios"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "playwright": "^1.62.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/status-bar": "^8.0.3"
  }
}
